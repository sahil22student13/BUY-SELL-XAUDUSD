//@version=6
// ═══════════════════════════════════════════════════════════════════════════
// Aether Signals — Buy / Sell / Retrace Buy / Retrace Sell on the chart, no backtest orders.
// Signals confirm on the bar close. Stop is beyond the sweep. TP1/TP2/TP3 = 1R/2R/3R.
// Pivots confirm only after N closed bars. request.security uses lookahead_off.
// ═══════════════════════════════════════════════════════════════════════════
indicator("Aether Signals SMC ", "Aether", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 300)

colBull = #26A69A
colBear = #EF5350
colZig  = #80CBC4
colLiq  = #FFD54F
colSweep = #FF9800
colTap  = #FFC107
colTrap = #E65100
colMajor = #90A4AE
colRange = #78909C

// ── Inputs ─────────────────────────────────────────────────────────────────
// ── CHART PRESET ─────────────────────────────────────────────────────────────
grpPRESET = "📊 CHART PRESET"
chartPreset = input.string("Manual", "Chart Timeframe Preset",
     options = ["Manual", "1m Scalp", "3m Scalp", "5m Swing", "15m Swing"],
     group = grpPRESET,
     tooltip = "Select your chart timeframe to auto-configure ALL settings for maximum accuracy and zero clutter:\n\n1m Scalp  → Pivot: 5 (Major 15) · iPivot: 2 (iBOS OFF) · HH/LL tags: OFF · Fib: 2.2 ATR · Setup: 60 bars (1h) · Liq: 5m+15m+1H · HTF: 5m+15m+1H · Exit: 5m · Retrace: 15m · Boxes: 2 · Score: 5/7\n3m Scalp  → Pivot: 5 (Major 15) · iPivot: 3 · HH/LL tags: ON · Fib: 1.8 ATR · Setup: 40 bars (2h) · Liq: 5m+15m+1H · HTF: 5m+15m+1H · Exit: 5m · Retrace: 1H+15m · Boxes: 2 · Score: 5/7\n5m Swing  → Pivot: 5 (Major 20) · iPivot: 3 · HH/LL tags: ON · Fib: 1.5 ATR · Setup: 30 bars (2.5h) · Liq: 15m+1H+4H · HTF: 15m+1H+4H · Exit: 15m · Retrace: 1H+15m · Boxes: 2 · Score: 5/7\n15m Swing → Pivot: 7 (Major 25) · iPivot: 5 · HH/LL tags: ON · Fib: 1.2 ATR · Setup: 20 bars (5h) · Liq: 1H+4H+1D · HTF: 1H+4H+1D · Exit: 1H · Retrace: 4H+1H · Boxes: 2 · Score: 5/7\n\nManual = uses your custom individual inputs below.")

grpMS = "Market Structure"
zzMode      = input.string("ATR Displacement", "Swing Detection Mode",
     options = ["ATR Displacement", "Pivot Bars"], group = grpMS,
     tooltip = "ATR Displacement (Recommended): Swings are determined by real price movement & ATR volatility, completely independent of candle counts. Filters out chop and micro-wiggles.\nPivot Bars: Classic fixed N-candle pivot count.")
zzAtrDev    = input.float(1.5, "ATR Swing Reversal Distance", minval = 0.4, step = 0.1, group = grpMS,
     tooltip = "Price must reverse by at least this ATR multiple from the peak/trough to confirm a new swing leg.")
pivotLen    = input.int(5, "Minor Pivot Length (if Pivot Bars mode)", minval = 2, maxval = 50, group = grpMS,
     tooltip = "Internal structure fallback. A swing is confirmed only after this many bars have closed.")
majorLen    = input.int(15, "Major Pivot Length", minval = 5, maxval = 100, group = grpMS,
     tooltip = "Thicker line on the latest major high and low only. Hidden when it sits on the active minor level.")
showMajor   = input.bool(true, "Show major high / low", group = grpMS)
minSwingAtr = input.float(0.25, "Minimum Swing Distance (ATR×)", minval = 0.0, step = 0.05, group = grpMS)
showZigzag  = input.bool(true, "Show zigzag", group = grpMS)
showHH      = input.bool(true, "Show HH", group = grpMS, inline = "hhll")
showHL      = input.bool(true, "Show HL", group = grpMS, inline = "hhll")
showLH      = input.bool(true, "Show LH", group = grpMS, inline = "lhll")
showLL      = input.bool(true, "Show LL", group = grpMS, inline = "lhll")
zzLblAtr    = input.float(0.1, "Zigzag label height (ATR×)", minval = 0.0, step = 0.05, group = grpMS,
     tooltip = "Vertical offset of HH/HL/LH/LL labels from the swing candle.")
swingLines  = input.string("Active only", "Swing level lines",
     options = ["Active only", "All recent", "Off"], group = grpMS,
     tooltip = "Active only = latest swing high + low, extend until broken (best for spotting bull↔bear shift). All recent = line at every HH/HL/LH/LL.")
showBias    = input.bool(true, "Show trend bias label", group = grpMS,
     tooltip = "Bullish sequence HL→HH→HL→HH · Bearish sequence LH→LL→LH→LL")

grpBOS = "BOS"
bosMode    = input.string("Candle Close", "BOS Confirmation Mode",
     options = ["Candle Close", "Wick Break", "Candle Close + Minimum Displacement"], group = grpBOS,
     tooltip = "Default Candle Close — do not trigger BOS on wick alone.")
minDispAtr = input.float(0.50, "Minimum Displacement (ATR×)", minval = 0.05, step = 0.05, group = grpBOS)
showBOS    = input.bool(true, "Show BOS", group = grpBOS)
colBosBull = input.color(#26A69A, "Bullish BOS color (BOS ↑)", group = grpBOS)
colBosBear = input.color(#EF5350, "Bearish BOS color (BOS ↓)", group = grpBOS)

grpCH = "CHoCH"
enableChoch = input.bool(true, "Enable CHoCH", group = grpCH,
     tooltip = "Off: a counter-trend break is drawn as BOS. On: bearish bias + break up is CHoCH ↑, and the inverse.")
chochMode  = input.string("Candle Close", "CHoCH Confirmation Mode",
     options = ["Candle Close", "Wick Break", "Candle Close + Minimum Displacement"], group = grpCH)
showChoch  = input.bool(true, "Show CHoCH", group = grpCH)
colChBull  = input.color(#26A69A, "Bullish CHoCH color (CHoCH ↑)", group = grpCH)
colChBear  = input.color(#EF5350, "Bearish CHoCH color (CHoCH ↓)", group = grpCH)

grpINT = "INTERNAL STRUCTURE"
enableInt   = input.bool(true,  "Show internal BOS / CHoCH", group = grpINT,
     tooltip = "Uses a shorter pivot length to detect smaller breaks inside the current swing leg. Draws iBOS (solid) and iCHoCH (dashed) labels independently of the main structure.")
iPivotLen   = input.int(3, "Internal pivot length", minval = 1, maxval = 10, group = grpINT,
     tooltip = "Bars each side to confirm an internal swing pivot. 2–3 is recommended for scalping; 4–5 for swing setups.")
showIBOS    = input.bool(true, "Show iBOS",   group = grpINT, inline = "ishow")
showIChoch  = input.bool(true, "Show iCHoCH", group = grpINT, inline = "ishow")
colIBosBull = input.color(#26A69A, "iBOS ↑",   group = grpINT, inline = "ibos")
colIBosBear = input.color(#EF5350, "iBOS ↓",   group = grpINT, inline = "ibos")
colIChBull  = input.color(#00BCD4, "iCHoCH ↑", group = grpINT, inline = "ich")
colIChBear  = input.color(#FF9800, "iCHoCH ↓", group = grpINT, inline = "ich")
iMarkKeep   = input.int(4, "Marks to keep", minval = 2, maxval = 30, group = grpINT,
     tooltip = "How many internal iBOS / iCHoCH marks remain visible. Older ones are automatically removed (4–5 recommended to avoid stacking).")

grpIDM = "INDUCEMENT"
enableIdm  = input.bool(true, "Enable inducement", group = grpIDM,
     tooltip = "After BOS, first internal swing against the move = INDUCEMENT (liquidity trap). Break of IDM ≠ reversal — wait for CHoCH.")
showIdm    = input.bool(true, "Show inducement level", group = grpIDM)
idmSens    = input.float(0.25, "Min IDM distance (ATR×)", minval = 0.05, step = 0.05, group = grpIDM)
colIdm     = input.color(#FDD835, "Inducement color", group = grpIDM)
idmTrans   = input.int(20, "Inducement line fade", minval = 0, maxval = 85, group = grpIDM,
     tooltip = "Line transparency. The IDM is a dashed line from its swing to the current candle with a label at the end: 'IDM - price · sweep → LONG/SHORT bias'.")
idmExpire  = input.int(36, "Sweep must react within (bars)", minval = 3, maxval = 300, group = grpIDM,
     tooltip = "After the IDM is swept, price must close back through it within this many bars. Otherwise the label turns grey: 'no reaction · stand aside'.")
showIdmHint = input.bool(true, "Show buy/sell hint after IDM", group = grpIDM,
     tooltip = "One pill on the right. It moves from the inducement step to the live score, for example SHORT 3/7 · wait 0.50-0.62.")

grpHTF = "HTF MARKET STRUCTURE"
showHtfStruct = input.bool(true, "Show HTF Structure (BOS / CHoCH) on Chart", group = grpHTF)
show5mStruct  = input.bool(true, "Show 5m Structure",  group = grpHTF, inline = "htf1")
show15mStruct = input.bool(true, "Show 15m Structure", group = grpHTF, inline = "htf1")
show1hStruct  = input.bool(true, "Show 1H Structure",  group = grpHTF, inline = "htf2")
show4hStruct  = input.bool(true, "Show 4H Structure",  group = grpHTF, inline = "htf2")
show1dStruct  = input.bool(false, "Show 1D Structure", group = grpHTF)
showHtfSwings = input.bool(false, "Show HTF HH / HL / LH / LL", group = grpHTF,
     tooltip = "Off keeps the chart clean. On shows only the latest 1H and 4H swing tag — no second zigzag.")

// ── HTF MATRIX / HUD ──────────────────────────────────────────────────────────
grpHUD      = "🖥️ HTF MATRIX / HUD"
showHud     = input.bool(true, "Show HTF Bias HUD Table", group = grpHUD,
     tooltip = "Displays real-time trend & structure bias for 5m, 15m, 1H, 4H, 1D, plus chart timeframe and consensus verdict.")
hudPosInput = input.string("Top Right", "HUD Position",
     options = ["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group = grpHUD)
hudSize     = input.string("Small", "HUD Size",
     options = ["Tiny", "Small", "Normal"], group = grpHUD)
hudShow1D   = input.bool(true, "Include 1D in HUD", group = grpHUD)

grpLIQ = "LIQUIDITY (BSL / SSL)"
showLiq       = input.bool(true, "Show liquidity yellow blocks", group = grpLIQ)
showBSL       = input.bool(true, "Show BSL", group = grpLIQ, inline = "bslssl")
showSSL       = input.bool(true, "Show SSL", group = grpLIQ, inline = "bslssl")
liqUseChartIn   = input.bool(true,  "Liquidity: Chart TF", group = grpLIQ)
liqUse3mIn      = input.bool(false, "Liquidity: 3m",  group = grpLIQ, inline = "liq0")
liqUse5mIn      = input.bool(false, "Liquidity: 5m",  group = grpLIQ, inline = "liq0")
liqUse15mIn     = input.bool(true,  "Liquidity: 15m", group = grpLIQ, inline = "liq1")
liqUse1hIn      = input.bool(true,  "Liquidity: 1H",  group = grpLIQ, inline = "liq1")
liqUse4hIn      = input.bool(false, "Liquidity: 4H",  group = grpLIQ, inline = "liq2")
liqUse1dIn      = input.bool(false, "Liquidity: 1D",  group = grpLIQ, inline = "liq2")
liqBlockAtr   = input.float(0.15, "Block height (ATR×)", minval = 0.02, step = 0.05, group = grpLIQ)
liqMaxPerTf   = input.int(3, "Max pending liquidity per TF/side", minval = 1, maxval = 6, group = grpLIQ,
     tooltip = "Pending (unswept) yellow blocks only.")
showTapLiq    = input.bool(true,  "Show Tap (T)", group = grpLIQ, inline = "liqtypes")
showSweepLiq  = input.bool(false, "Show Sweep (S)", group = grpLIQ, inline = "liqtypes")
showTxLiq     = input.bool(false, "Show TX", group = grpLIQ, inline = "liqtypes")
liqMaxDone    = input.int(2, "Max Tap marks", minval = 1, maxval = 6, group = grpLIQ,
     tooltip = "Keep only the latest Tap marks; older ones are removed.")
liqCol        = input.color(#FFD54F, "Block color", group = grpLIQ)
liqTrans      = input.int(75, "Block transparency", minval = 50, maxval = 95, group = grpLIQ)
liqExtend     = input.bool(true, "Extend pending liquidity to the right", group = grpLIQ,
     tooltip = "Pending = yellow until taken. Tap keeps only the last N marks.")
eqTolAtr      = input.float(0.08, "Equal high/low tolerance (ATR×)", minval = 0.01, step = 0.01, group = grpLIQ,
     tooltip = "Resting highs or lows inside this distance are tagged EQH / EQL on the existing yellow label.")
eqMinTouches  = input.int(2, "Minimum equal touches", minval = 2, maxval = 6, group = grpLIQ)
showSweepMark = input.bool(true, "Show sweep marks", group = grpLIQ,
     tooltip = "At each sweep (wick through liquidity, close back inside): a dashed line from the swept level's origin to the sweep candle, plus TF - SSL/BSL SWEEP - price.")
sweepKeep     = input.int(3, "Sweep marks to keep", minval = 1, maxval = 10, group = grpLIQ)
liqStyle      = input.string("Blocks", "Liquidity style", options = ["Blocks", "Clean"], group = grpLIQ,
     tooltip = "Blocks = yellow boxes with the text inside, e.g. '1h - BSL - 2650.40 - new'. Pending blocks run past the last candle without rail collisions. Clean (mxwell) = dotted line to a right-edge rail label.")
liqRightBars  = input.int(8, "Blocks: extend past last candle (bars)", minval = 0, maxval = 40, group = grpLIQ)
liqRailMax    = input.int(2, "Clean: labels per side", minval = 1, maxval = 6, group = grpLIQ)
liqFreshHours = input.int(8, "Clean: fresh window (hours)", minval = 1, maxval = 48, group = grpLIQ,
     tooltip = "Younger than this shows 'Fresh'; older shows the date it formed.")
bool liqClean = chartPreset == "Manual" ? (liqStyle == "Clean") : false

bool useChart = true
// Preset-driven HTF structure flags (override individual checkboxes when preset active)
bool eff5mStruct  = chartPreset == "Manual" ? show5mStruct  : (chartPreset == "1m Scalp" or chartPreset == "3m Scalp")
bool eff15mStruct = chartPreset == "Manual" ? show15mStruct : (chartPreset == "1m Scalp" or chartPreset == "3m Scalp" or chartPreset == "5m Swing")
bool eff1hStruct  = chartPreset == "Manual" ? show1hStruct  : (chartPreset != "Manual")
bool eff4hStruct  = chartPreset == "Manual" ? show4hStruct  : (chartPreset == "5m Swing" or chartPreset == "15m Swing")
bool eff1dStruct  = chartPreset == "Manual" ? show1dStruct  : (chartPreset == "15m Swing")
bool use5m    = showHtfStruct and eff5mStruct
bool use15m   = showHtfStruct and eff15mStruct
bool use1h    = showHtfStruct and eff1hStruct
bool use4h    = showHtfStruct and eff4hStruct
bool use1d    = showHtfStruct and eff1dStruct

grpVIS = "Visuals"
mergeTolAtr   = input.float(0.35, "Merge levels within (ATR×)", minval = 0.05, step = 0.05, group = grpVIS,
     tooltip = "Nearby BOS/CHoCH from any TF share one line and merge labels.")
maxPerTf      = input.int(1, "Max marks per timeframe", minval = 1, maxval = 5, group = grpVIS,
     tooltip = "1 = latest active mark per TF (keeps chart clean without stacking). 2 = latest BOS + latest CHoCH per TF.")
showChartTf   = input.bool(true, "Show chart-TF structure marks", group = grpVIS)

grpRNG = "RANGE"
enableRange = input.bool(true, "Enable consolidation", group = grpRNG,
     tooltip = "One faint box while price is sideways. High and low are the box edges. It does not signal a trade.")
rangeLen    = input.int(20, "Range length", minval = 8, maxval = 80, group = grpRNG)
rangeAtr    = input.float(3.5, "Range sensitivity (ATR×)", minval = 1.0, step = 0.5, group = grpRNG,
     tooltip = "Smaller = only tight ranges. A trending chart stays clear.")

grpFIB = "FIBONACCI"
enableFib = input.bool(true, "Enable Fibonacci", group = grpFIB,
     tooltip = "Only after CHoCH. One transparent zone between the levels you enable — not a full fib ladder.")
use500    = input.bool(true, "0.500", group = grpFIB, inline = "fibs")
use618    = input.bool(true, "0.618", group = grpFIB, inline = "fibs")
use786    = input.bool(true, "0.786", group = grpFIB, inline = "fibs")
colFibIn  = input.color(#F5C542, "Zone", group = grpFIB, inline = "fibc")
colFibLvl = input.color(#90A4AE, "Levels", group = grpFIB, inline = "fibc")
fibRightBars = input.int(12, "Extend past last candle (bars)", minval = 9, maxval = 40, group = grpFIB,
     tooltip = "The fib box and its level tags run this far into the empty space on the right.")
fibTrans  = input.int(88, "Zone transparency", minval = 70, maxval = 96, group = grpFIB)
fibMinAtr = input.float(1.5, "Min impulse (ATR×)", minval = 0.5, step = 0.25, group = grpFIB,
     tooltip = "The zone stays hidden until the CHoCH impulse is at least this large. It keeps extending with new extremes until price trades back into 0.50-0.62.")

grpSIG = "SETUPS"
enableLong  = input.bool(true, "Enable long setups", group = grpSIG, inline = "sig")
enableShort = input.bool(true, "Enable short setups", group = grpSIG, inline = "sig")
showSetup   = input.bool(true, "Show setup label", group = grpSIG)
sigKeep     = input.int(80, "Past signals to keep", minval = 5, maxval = 150, group = grpSIG,
     tooltip = "How many older Buy / Sell / Retrace Buy / Retrace Sell tags (with their TP / SL hit marks) stay on the chart. TradingView allows 500 labels in total, so very high values can push out the oldest ones.")
minScore    = input.int(5, "Minimum confluence score", minval = 1, maxval = 7, group = grpSIG,
     tooltip = "Sweep, CHoCH, structure, 0.50–0.62, rejection, HTF bias, nearby liquidity. Higher score (5+) ensures candle rejection and HTF bias agreement for sniper entries.")
setupWindow = input.int(80, "Sweep must lead CHoCH (bars)", minval = 5, maxval = 300, group = grpSIG)
colBuySig   = input.color(#00A152, "Buy / Retrace Buy", group = grpSIG, inline = "sigc")
colSellSig  = input.color(#E53935, "Sell / Retrace Sell", group = grpSIG, inline = "sigc")
grpPD = "PREMIUM & DISCOUNT ZONES"
showPdZones = input.bool(true, "Show Premium / Discount Zones", group = grpPD,
     tooltip = "Shades the active dealing range: Premium (>0.50) red for shorts, Discount (<0.50) green for buys, and Equilibrium (0.500) midpoint line.")
pdStyle     = input.string("Compact Rail", "Zone Style",
     options = ["Compact Rail", "Full Shading", "Lines Only"], group = grpPD,
     tooltip = "Compact Rail (Recommended): Displays Premium & Discount in the right margin, leaving candles 100% visible and unobstructed.\nFull Shading: Spans across the entire impulse leg.\nLines Only: Minimal boundary lines with right-edge price tags.")
colPremium  = input.color(#EF5350, "Premium Zone", group = grpPD, inline = "pdcol")
colDiscount = input.color(#26A69A, "Discount Zone", group = grpPD, inline = "pdcol")
colEqLine   = input.color(#90A4AE, "Equilibrium (0.50) Line", group = grpPD)
pdTrans     = input.int(88, "Zone transparency", minval = 50, maxval = 98, group = grpPD,
     tooltip = "Controls the shade visibility of the Premium and Discount blocks (lower = more visible). Default 88.")
pdRightBars = input.int(22, "Extend into right margin (bars)", minval = 10, maxval = 80, group = grpPD,
     tooltip = "How far past the latest candle the blocks project into the right empty space, keeping text outside the candle formation.")

grpRSK = "RISK"
showEntry  = input.bool(false, "Show entry", group = grpRSK, inline = "rsk")
showStop   = input.bool(true, "Show stop", group = grpRSK, inline = "rsk")
showTarget = input.bool(true, "Show target", group = grpRSK, inline = "rsk")
colRew     = input.color(#2E7D32, "Buy/Sell reward", group = grpRSK, inline = "pcol1")
colRisk    = input.color(#C62828, "risk", group = grpRSK, inline = "pcol1")
colRetRew  = input.color(#1E88E5, "Re-entry reward", group = grpRSK, inline = "pcol2",
     tooltip = "Plan box colours for Retrace Buy / Retrace Sell, so the trade zone stands apart from a fresh Buy / Sell.")
colRetRisk = input.color(#8E24AA, "risk", group = grpRSK, inline = "pcol2")
tpLineAtr  = input.float(1.0, "TP hit marker height (ATR×)", minval = 0.3, step = 0.1, group = grpRSK)
rrPick     = input.string("1:2", "Risk / Reward", options = ["1:1", "1:2", "1:3"], group = grpRSK,
     tooltip = "Which target counts as the trade finished. 1:1 is TP1, 1:2 is TP2, 1:3 is TP3. A new retracement signal in the same direction waits until this target or the stop is hit.")

grpRET = "RETRACEMENT"
enableRet  = input.bool(true, "Enable retracement Buy / Sell", group = grpRET,
     tooltip = "Trend continuation: after a BOS/CHoCH, wait for price to pull back into 0.50-0.618 of the latest impulse, then a rejection or engulfing candle closes back out of the zone.")
retHtfIn     = input.string("1H + 15m", "Trend filter", options = ["1H + 15m", "4H + 1H", "15m only", "Chart only"], group = grpRET,
     tooltip = "Retracement signals only fire when these timeframes agree with the chart trend. Chart only = no higher-timeframe check.")
showRetZone = input.bool(true, "Show retracement zone", group = grpRET)

grpEXIT = "EXIT / WARNING"
showExit   = input.bool(true, "Show exit signals", group = grpEXIT,
     tooltip = "While a Buy/Sell is live, dots on top of the candle, coloured by timeframe:\nlight orange 3m · dark orange 5m · red 15m · dark red 1H.\nThe timeframe set below closes the trade: 'EXIT - 15m - CHoCH ↓ · close, look SELL - price'. Lower timeframes print early dots only.\nEXIT BE = TP1 was hit, then price closed back through entry → close at breakeven and wait.")
exitOnBE   = input.bool(true, "EXIT BE after TP1", group = grpEXIT)
exitTfIn     = input.string("15m", "EXIT on structure from", options = ["Chart TF", "5m", "15m", "1H"], group = grpEXIT,
     tooltip = "Which timeframe's CHoCH / BOS against the trade closes it.\nChart TF: fastest, but on 3m / 5m small pullbacks can kick you out of good trades.\n5m (good for 3m charts): ignores 3m noise, still reacts quickly.\n15m (recommended for 3m / 5m charts): only a 15m break closes the trade.\n1H: holds through most pullbacks; the stop does more of the work.\nIf your chart is already this timeframe or higher, the chart TF is used.")
warnChart  = input.bool(true, "Early EXIT dots from lower timeframes", group = grpEXIT,
     tooltip = "Timeframes below the one set above show a dot on top of the candle when their structure breaks against the trade, e.g. 'EXIT - 3m - CHoCH ↓ · tighten stop'. The trade stays open; tighten the stop or take partial.")
colEx3     = input.color(#FFB74D, "3m / chart", group = grpEXIT, inline = "extf")
colEx5     = input.color(#EF6C00, "5m", group = grpEXIT, inline = "extf")
colEx15    = input.color(#FF1744, "15m", group = grpEXIT, inline = "extf")
colEx60    = input.color(#B71C1C, "1H", group = grpEXIT, inline = "extf")
showWarn   = input.bool(true, "Show warnings", group = grpEXIT,
     tooltip = "WARN = opposite liquidity swept and rejected (take partial / move stop to entry), or the 1H bias turned against the trade.")
warnSweep  = input.bool(true, "Warn: opposite sweep", group = grpEXIT, inline = "wrn")
warnHtf    = input.bool(true, "Warn: 1H bias flip", group = grpEXIT, inline = "wrn")
colExit    = input.color(#FF1744, "Exit", group = grpEXIT, inline = "exc")
colWarn    = input.color(#FFA000, "Warning", group = grpEXIT, inline = "exc")



grpKEY = "KEY LEVELS"
showKey   = input.bool(true, "Show key levels", group = grpKEY,
     tooltip = "Previous period highs and lows. Label says taken once price has traded through the level in the current period.")
keyDayIn    = input.bool(true,  "Previous day",   group = grpKEY, inline = "key1")
key4hIn     = input.bool(true,  "Previous 4H",    group = grpKEY, inline = "key1")
key1hIn     = input.bool(false, "Previous 1H",    group = grpKEY, inline = "key1")
keyWeekIn   = input.bool(true,  "Previous week",  group = grpKEY, inline = "key2")
keyMonthIn  = input.bool(false, "Previous month", group = grpKEY, inline = "key2")
colKeyD   = input.color(#42A5F5, "Day",   group = grpKEY, inline = "keyc")
colKey4   = input.color(#AB47BC, "4H",    group = grpKEY, inline = "keyc")
colKeyW   = input.color(#FFA726, "Week",  group = grpKEY, inline = "keyc")
colKeyM   = input.color(#BDBDBD, "Month", group = grpKEY, inline = "keyc")
colKey1   = input.color(#80DEEA, "1H",    group = grpKEY, inline = "keyc")
keyRightBars = input.int(30, "Extend past last candle (bars)", minval = 4, maxval = 80, group = grpKEY,
     tooltip = "Where the 'PDH / P4H H - price' tags sit. 30 puts them just past the trade plan (which ends at 28).")
keyMergeAtr = input.float(0.15, "Merge labels within (ATR×)", minval = 0.02, step = 0.05, group = grpKEY,
     tooltip = "Levels this close share one label, e.g. PDH and previous 4H high.")

grpAL = "ALERTS"
alertsOn = input.bool(true, "Enable alerts", group = grpAL)

// ── Effective settings — all driven by chartPreset; manual = use inputs as-is ──
// Map chartPreset to legacy presetIn string (all existing liqUse* logic unchanged)
string presetIn = chartPreset == "1m Scalp"  ? "1m Chart Preset"  :
     chartPreset == "3m Scalp"  ? "3m Chart Preset"  :
     chartPreset == "5m Swing"  ? "5m Chart Preset"  :
     chartPreset == "15m Swing" ? "15m Chart Preset" : "Manual (Use Checkboxes)"

// Liquidity TFs (unchanged logic, now driven by chartPreset via presetIn)
bool   liqUseChart = presetIn == "Manual (Use Checkboxes)" ? liqUseChartIn : false
bool   liqUse3m    = presetIn == "Manual (Use Checkboxes)" ? liqUse3mIn : false
bool   liqUse5m    = presetIn == "Manual (Use Checkboxes)" ? liqUse5mIn : (presetIn == "1m Chart Preset" or presetIn == "3m Chart Preset")
bool   liqUse15m   = presetIn == "Manual (Use Checkboxes)" ? liqUse15mIn : (presetIn == "1m Chart Preset" or presetIn == "3m Chart Preset" or presetIn == "5m Chart Preset")
bool   liqUse1h    = presetIn == "Manual (Use Checkboxes)" ? liqUse1hIn : (presetIn != "Manual (Use Checkboxes)")
bool   liqUse4h    = presetIn == "Manual (Use Checkboxes)" ? liqUse4hIn : (presetIn == "5m Chart Preset" or presetIn == "15m Chart Preset")
bool   liqUse1d    = presetIn == "Manual (Use Checkboxes)" ? liqUse1dIn : (presetIn == "15m Chart Preset")

// Exit TF — preset auto-selects the correct higher TF to close the trade
string exitTf = chartPreset == "Manual" ? exitTfIn :
     chartPreset == "1m Scalp"  ? "5m"      :
     chartPreset == "3m Scalp"  ? "5m"      :
     chartPreset == "5m Swing"  ? "15m"     :
     chartPreset == "15m Swing" ? "1H"      : exitTfIn

// Retracement HTF filter — which TFs must agree before a retrace signal fires
string retHtf = chartPreset == "Manual" ? retHtfIn :
     chartPreset == "1m Scalp"  ? "15m only" :
     chartPreset == "3m Scalp"  ? "1H + 15m" :
     chartPreset == "5m Swing"  ? "1H + 15m" :
     chartPreset == "15m Swing" ? "4H + 1H"  : retHtfIn

// Internal pivot length — shorter for faster charts, longer for slower ones
int effIPivot = chartPreset == "Manual" ? iPivotLen :
     chartPreset == "1m Scalp"  ? 2 :
     chartPreset == "3m Scalp"  ? 3 :
     chartPreset == "5m Swing"  ? 3 :
     chartPreset == "15m Swing" ? 5 : iPivotLen

bool   keyDay   = keyDayIn
bool   key4h    = key4hIn
bool   key1h    = key1hIn
bool   keyWeek  = keyWeekIn
bool   keyMonth = keyMonthIn

// --- SMC TOOLKIT INPUTS ---
grpFvg = "Fair Value Gaps (FVG)"
showFvg = input.bool(true, "Show FVGs", group=grpFvg)
fvgBullCol = input.color(color.new(color.green, 80), "Bullish FVG", group=grpFvg)
fvgBearCol = input.color(color.new(color.red, 80), "Bearish FVG", group=grpFvg)
useFvgEntry = input.bool(true, "Use FVG/OB for Entry (Overrides Fib)", group=grpFvg)
maxBoxes = input.int(2, "Max FVG / OB to show", group=grpFvg, tooltip="Lower this number to clean up your chart. It limits how many unmitigated boxes trail price.")

grpEq = "Equal Highs/Lows (EQH/EQL)"
showEq = input.bool(true, "Show EQH/EQL", group=grpEq)
smcEqTolAtr = input.float(0.5, "Tolerance (ATRx)", group=grpEq)
useEqhTp = input.bool(true, "Use EQH/EQL for Final Take Profit", group=grpEq)

grpOb = "Order Blocks (OB)"
showOb = input.bool(true, "Show Order Blocks", group=grpOb)
obBullCol = input.color(color.new(color.blue, 80), "Bullish OB", group=grpOb)
obBearCol = input.color(color.new(color.orange, 80), "Bearish OB", group=grpOb)

grpSess = "Sessions & Killzones"
tzIn = input.string("UTC", "Timezone", options=["UTC", "America/New_York", "Europe/London", "Asia/Tokyo", "Exchange"], group=grpSess)
showSess = input.bool(true, "Show Sessions", group=grpSess)
asiaSess = input.session("1800-0000", "Asian Range", group=grpSess)
lonSess = input.session("0200-0500", "London Killzone", group=grpSess)
nySess = input.session("0700-1000", "New York Killzone", group=grpSess)
asiaCol = input.color(color.new(color.purple, 90), "Asia Color", group=grpSess)
lonCol = input.color(color.new(color.teal, 90), "London Color", group=grpSess)
nyCol = input.color(color.new(color.fuchsia, 90), "NY Color", group=grpSess)

// ── Additional Effective Settings (Presets vs Manual) ─────────────────────────
// External Minor & Major Pivot Lengths — optimized per timeframe
int effPivotLen = chartPreset == "Manual" ? pivotLen :
     chartPreset == "1m Scalp"  ? 5 :
     chartPreset == "3m Scalp"  ? 5 :
     chartPreset == "5m Swing"  ? 5 :
     chartPreset == "15m Swing" ? 7 : pivotLen

int effMajorLen = chartPreset == "Manual" ? majorLen :
     chartPreset == "1m Scalp"  ? 15 :
     chartPreset == "3m Scalp"  ? 15 :
     chartPreset == "5m Swing"  ? 20 :
     chartPreset == "15m Swing" ? 25 : majorLen

// On 1m scalp, HH/HL/LH/LL text labels crowd the candles without adding value — mute them for 1m Scalp preset
bool effShowHh = chartPreset == "Manual" ? showHH : (chartPreset == "1m Scalp" ? false : showHH)
bool effShowHl = chartPreset == "Manual" ? showHL : (chartPreset == "1m Scalp" ? false : showHL)
bool effShowLh = chartPreset == "Manual" ? showLH : (chartPreset == "1m Scalp" ? false : showLH)
bool effShowLl = chartPreset == "Manual" ? showLL : (chartPreset == "1m Scalp" ? false : showLL)

// Internal structure display flags — turn off noisy iBOS on 1m scalp, keep only high-value iCHoCH
bool effShowIBOS   = chartPreset == "Manual" ? showIBOS : (chartPreset == "1m Scalp" ? false : showIBOS)
bool effShowIChoch = chartPreset == "Manual" ? showIChoch : true

// Internal marks to keep — 4 for scalping (1m/3m clean), 5 for swings
int effIMarkKeep   = chartPreset == "Manual" ? iMarkKeep : (chartPreset == "1m Scalp" or chartPreset == "3m Scalp" ? 4 : 5)

// Max marks per timeframe — 1 prevents stacked BOS labels across timeframes
int effMaxPerTf    = chartPreset == "Manual" ? maxPerTf : 1

// Max FVG / OB boxes to show — 2 keeps only the closest unmitigated zones
int effMaxBoxes    = chartPreset == "Manual" ? maxBoxes : 2

// Minimum confluence score for setups — 5/7 requires rejection / HTF confirmation for sniper accuracy
int effMinScore    = chartPreset == "Manual" ? minScore : 5

// Dynamic Fib impulse size per timeframe preset:
// 1m Scalp requires higher ATR multiplier (2.2) to filter out 1m chop ripples and guarantee real displacement.
// 15m Swing has naturally large ATR bars, so 1.2 is already a multi-hour impulse leg.
float effFibMinAtr = chartPreset == "Manual" ? fibMinAtr :
     chartPreset == "1m Scalp"  ? 2.2 :
     chartPreset == "3m Scalp"  ? 1.8 :
     chartPreset == "5m Swing"  ? 1.5 :
     chartPreset == "15m Swing" ? 1.2 : fibMinAtr

// Dynamic setup window (how far back a sweep can lead CHoCH):
// 1m: 60 bars (1 hr) · 3m: 40 bars (2 hrs) · 5m: 30 bars (2.5 hrs) · 15m: 20 bars (5 hrs)
int effSetupWindow = chartPreset == "Manual" ? setupWindow :
     chartPreset == "1m Scalp"  ? 60 :
     chartPreset == "3m Scalp"  ? 40 :
     chartPreset == "5m Swing"  ? 30 :
     chartPreset == "15m Swing" ? 20 : setupWindow

// Dynamic Fib right extension past the latest candle:
int effFibRightBars = chartPreset == "Manual" ? fibRightBars :
     chartPreset == "1m Scalp"  ? 18 :
     chartPreset == "3m Scalp"  ? 14 :
     chartPreset == "5m Swing"  ? 12 :
     chartPreset == "15m Swing" ? 10 : fibRightBars

// Dynamic ATR displacement swing distance per preset:
float effZzAtrDev = chartPreset == "Manual" ? zzAtrDev :
     chartPreset == "1m Scalp"  ? 1.8 :
     chartPreset == "3m Scalp"  ? 1.5 :
     chartPreset == "5m Swing"  ? 1.2 :
     chartPreset == "15m Swing" ? 1.0 : zzAtrDev

float atrVal = ta.atr(14)
float majPh  = ta.pivothigh(high, effMajorLen, effMajorLen)
float majPl  = ta.pivotlow(low, effMajorLen, effMajorLen)
float rngHH  = ta.highest(high, rangeLen)
float rngLL  = ta.lowest(low, rangeLen)
float rngNet = math.abs(close - nz(close[rangeLen], close))
int   majPivotTm = time[effMajorLen]
int   rngTm = int(nz(time[rangeLen], time))
f_tf_tag() =>
    string t = timeframe.period
    t == "1" ? "1m" : t == "3" ? "3m" : t == "5" ? "5m" : t == "15" ? "15m" :
     t == "30" ? "30m" : t == "45" ? "45m" : t == "60" ? "1h" : t == "120" ? "2h" :
     t == "180" ? "3h" : t == "240" ? "4h" : t == "D" ? "1d" : t == "W" ? "1W" : t

f_brk_up(float h, float l, float c, float lvl, float a, string mode) =>
    bool r = false
    if not na(lvl)
        if mode == "Wick Break"
            r := h > lvl
        else if mode == "Candle Close + Minimum Displacement"
            r := c > lvl and (c - lvl) >= a * minDispAtr
        else
            r := c > lvl
    r

f_brk_dn(float h, float l, float c, float lvl, float a, string mode) =>
    bool r = false
    if not na(lvl)
        if mode == "Wick Break"
            r := l < lvl
        else if mode == "Candle Close + Minimum Displacement"
            r := c < lvl and (lvl - c) >= a * minDispAtr
        else
            r := c < lvl
    r

// Structure engine — chart + request.security
// Structure engine — unified SMC engine for both External (pivotLen) & Internal (effIPivot)
// Bias from HH/HL (bull) / LH/LL (bear) BEFORE classifying the break.
f_structure(int pLen = 5, float devMult = -1.0) =>
    float a = ta.atr(14)
    float effDev = devMult > 0 ? devMult : effZzAtrDev
    float devDist = math.max(nz(a, 0) * effDev, syminfo.mintick * 10)
    float ph = ta.pivothigh(high, pLen, pLen)
    float pl = ta.pivotlow(low, pLen, pLen)
    var float sh = na
    var float sl = na
    var float prevSh = na
    var float prevSl = na
    var int   shTm = 0
    var int   slTm = 0
    var int   shBar = 0
    var int   slBar = 0
    var int   bias = 0
    var int   lastHighType = 0   // 1=HH, -1=LH
    var int   lastLowType = 0    // 1=HL, -1=LL
    var float lastUpLvl = na
    var float lastDnLvl = na
    var int   bosU = 0
    var int   bosD = 0
    var int   chU = 0
    var int   chD = 0
    var float evLvl = na
    var int   evSt = 0
    var int   evBr = 0
    var int   evKind = 0   // 1=BOS↑ 2=BOS↓ 3=CHoCH↑ 4=CHoCH↓
    var float zzSh = na
    var float zzSl = na
    var int   zzShTm = 0
    var int   zzSlTm = 0
    var int   zzN = 0

    // Trailing state for ATR displacement swing detection:
    var int   zzDir = 0          // 1 = tracking up leg peak, -1 = tracking down leg trough
    var float trailHi = na
    var int   trailHiTm = 0
    var int   trailHiBar = 0
    var float trailLo = na
    var int   trailLoTm = 0
    var int   trailLoBar = 0

    // A strategy or live bar can execute multiple times per bar. var state must only commit on confirmed closes.
    var int   passBar = -1
    bool isConf = barstate.ishistory or barstate.isconfirmed
    bool firstPass = passBar != bar_index
    if isConf
        passBar := bar_index

    // ── Confirm swings & classify HH/HL/LH/LL → bias ───────────────────────
    if zzMode == "ATR Displacement"
        if isConf
            if zzDir == 0
                if na(trailHi)
                    trailHi := high
                    trailHiTm := time
                    trailHiBar := bar_index
                    trailLo := low
                    trailLoTm := time
                    trailLoBar := bar_index
                else
                    if high > trailHi
                        trailHi := high
                        trailHiTm := time
                        trailHiBar := bar_index
                    if low < trailLo
                        trailLo := low
                        trailLoTm := time
                        trailLoBar := bar_index
                    if (close - trailLo) >= devDist
                        zzDir := 1
                        sl := trailLo
                        slTm := trailLoTm
                        slBar := trailLoBar
                        zzSl := trailLo
                        zzSlTm := trailLoTm
                        zzN += 1
                        lastLowType := 1
                        trailHi := high
                        trailHiTm := time
                        trailHiBar := bar_index
                    else if (trailHi - close) >= devDist
                        zzDir := -1
                        sh := trailHi
                        shTm := trailHiTm
                        shBar := trailHiBar
                        zzSh := trailHi
                        zzShTm := trailHiTm
                        zzN += 1
                        lastHighType := -1
                        trailLo := low
                        trailLoTm := time
                        trailLoBar := bar_index
            else if zzDir == 1
                if high > trailHi
                    trailHi := high
                    trailHiTm := time
                    trailHiBar := bar_index
                if (trailHi - close) >= devDist
                    if not na(sh)
                        prevSh := sh
                        lastHighType := trailHi > sh ? 1 : -1
                    else
                        lastHighType := 1
                    sh := trailHi
                    shTm := trailHiTm
                    shBar := trailHiBar
                    zzSh := trailHi
                    zzShTm := trailHiTm
                    zzN += 1
                    if lastHighType == 1 and lastLowType == 1
                        bias := 1
                    else if lastHighType == -1 and lastLowType == -1
                        bias := -1
                    zzDir := -1
                    trailLo := low
                    trailLoTm := time
                    trailLoBar := bar_index
            else // zzDir == -1
                if low < trailLo
                    trailLo := low
                    trailLoTm := time
                    trailLoBar := bar_index
                if (close - trailLo) >= devDist
                    if not na(sl)
                        prevSl := sl
                        lastLowType := trailLo > sl ? 1 : -1
                    else
                        lastLowType := -1
                    sl := trailLo
                    slTm := trailLoTm
                    slBar := trailLoBar
                    zzSl := trailLo
                    zzSlTm := trailLoTm
                    zzN += 1
                    if lastHighType == 1 and lastLowType == 1
                        bias := 1
                    else if lastHighType == -1 and lastLowType == -1
                        bias := -1
                    zzDir := 1
                    trailHi := high
                    trailHiTm := time
                    trailHiBar := bar_index
    else
        // Classic Pivot Bars logic
        if (firstPass or isConf) and not na(ph)
            bool distOk = minSwingAtr <= 0 or na(sl) or (ph - sl) >= nz(a, 0) * minSwingAtr
            if distOk
                if not na(sh)
                    prevSh := sh
                    lastHighType := ph > sh ? 1 : -1
                sh := ph
                shTm := int(nz(time[pLen], time))
                shBar := bar_index - pLen
                zzSh := ph
                zzShTm := shTm
                zzN += 1
                if lastHighType == 1 and lastLowType == 1
                    bias := 1
                else if lastHighType == -1 and lastLowType == -1
                    bias := -1

        if (firstPass or isConf) and not na(pl)
            bool distOkL = minSwingAtr <= 0 or na(sh) or (sh - pl) >= nz(a, 0) * minSwingAtr
            if distOkL
                if not na(sl)
                    prevSl := sl
                    lastLowType := pl > sl ? 1 : -1
                sl := pl
                slTm := int(nz(time[pLen], time))
                slBar := bar_index - pLen
                zzSl := pl
                zzSlTm := slTm
                zzN += 1
                if lastHighType == 1 and lastLowType == 1
                    bias := 1
                else if lastHighType == -1 and lastLowType == -1
                    bias := -1

    // ── Breaks (only after pivot bar is in the past) ───────────────────────
    bool pastSh = shBar > 0 and bar_index > shBar
    bool pastSl = slBar > 0 and bar_index > slBar
    // With-trend breaks use BOS mode. Counter-trend breaks use CHoCH mode.
    string upMode = enableChoch and bias == -1 ? chochMode : bosMode
    string dnMode = enableChoch and bias == 1 ? chochMode : bosMode
    bool up = pastSh and f_brk_up(high, low, close, sh, a, upMode)
    bool dn = pastSl and f_brk_dn(high, low, close, sl, a, dnMode)
    if up and dn
        if close >= open
            dn := false
        else
            up := false

    // Reset event pulse each bar; set only when a new break fires
    if firstPass
        evKind := 0

    // Bullish break of last swing high (committed on confirmed close to prevent intrabar repainting)
    //   bias bearish (-1) → CHoCH ↑   |   bias bullish/flat → BOS ↑
    if up and (na(lastUpLvl) or sh != lastUpLvl)
        if isConf
            if bias == -1 and enableChoch
                chU += 1
                evKind := 3
                lastHighType := 1
                lastLowType := 1
            else
                bosU += 1
                evKind := 1
                lastHighType := 1
                if lastLowType == 0
                    lastLowType := 1
            bias := 1
            lastUpLvl := sh
            evLvl := sh
            evSt := shTm
            evBr := time
        else
            evKind := (bias == -1 and enableChoch) ? 3 : 1
            evLvl := sh
            evSt := shTm
            evBr := time

    // Bearish break of last swing low (committed on confirmed close to prevent intrabar repainting)
    //   bias bullish (1) → CHoCH ↓   |   bias bearish/flat → BOS ↓
    if dn and (na(lastDnLvl) or sl != lastDnLvl)
        if isConf
            if bias == 1 and enableChoch
                chD += 1
                evKind := 4
                lastHighType := -1
                lastLowType := -1
            else
                bosD += 1
                evKind := 2
                lastLowType := -1
                if lastHighType == 0
                    lastHighType := -1
            bias := -1
            lastDnLvl := sl
            evLvl := sl
            evSt := slTm
            evBr := time
        else
            evKind := (bias == 1 and enableChoch) ? 4 : 2
            evLvl := sl
            evSt := slTm
            evBr := time

    [bosU, bosD, chU, chD, evLvl, evSt, evBr, evKind, zzSh, zzSl, zzShTm, zzSlTm, zzN, bias]

// Internal structure drawing arrays (kept separate from external lvlLines/lvlLabs)
var line[]  iLns = array.new_line()
var label[] iLbs = array.new_label()

f_i_push(int kind, float px, int tStart, int tBreak) =>
    bool isBull  = kind == 1 or kind == 3
    bool isChoch = kind == 3 or kind == 4
    bool allow   = (not isChoch and effShowIBOS) or (isChoch and effShowIChoch)
    if enableInt and allow and not na(px) and nz(tStart, 0) > 0 and nz(tBreak, 0) > 0
        color c    = isChoch ? (isBull ? colIChBull : colIChBear) : (isBull ? colIBosBull : colIBosBear)
        string lbl = isChoch ? (isBull ? "iCHoCH ↑" : "iCHoCH ↓") : (isBull ? "iBOS ↑" : "iBOS ↓")
        int xa  = int(math.min(tStart, tBreak))
        int xb  = int(math.max(tStart, tBreak))
        if xb <= xa
            xb := xa + 1
        int mid = int(math.round(0.5 * (xa + xb)))
        line ln = line.new(xa, px, xb, px, xloc.bar_time, extend.none,
             color.new(c, 20), isChoch ? line.style_dashed : line.style_solid, 1)
        label lb = label.new(mid, px, lbl, xloc.bar_time, yloc.price,
             color.new(c, 100), label.style_label_down, c, size.tiny,
             textalign = text.align_center)
        array.push(iLns, ln)
        array.push(iLbs, lb)
        while array.size(iLns) > effIMarkKeep
            line.delete(array.shift(iLns))
            label.delete(array.shift(iLbs))

// ── Marks: swing→break segment; merge nearby TF labels ─────────────────────
var line[]   lvlLines = array.new_line()
var label[]  lvlLabs  = array.new_label()
var float[]  lvlPx    = array.new_float()
var string[] lvlTxt   = array.new_string()
var string[] lvlTf    = array.new_string()
var int[]    lvlAge   = array.new_int()

// Inducement state (must be declared before fireChart uses it)
var bool   idmArmed = false
var int    idmWaitDir = 0    // -1 = wait internal low (after BOS↑); 1 = wait internal high (after BOS↓)
var float  idmLevel = na
var int    idmTm = 0
var bool   idmTaken = false
var line   idmLn = na
var label  idmLb = na
var label  idmHintLb = na
var string idmHint = ""
var int    idmBiasSide = 0   // 1 = favour long after sweep, -1 = favour short
var int    idmStage = 0      // 0 not swept · 1 swept, waiting · 2 reclaimed · 3 confirmed · 4 failed · 5 no reaction
var float  idmProt = na      // protected swing of the BOS leg; a close beyond it kills the idea
var line   idmOldLn = na
var label  idmOldLb = na
var line   idmLn2 = na
var line   idmOldLn2 = na
var int    idmEndT = 0       // where the line stops once the outcome is final (stage 3-5)

f_idm_txt(int stage, int side, float lvl) =>
    string d  = side == 1 ? "LONG" : "SHORT"
    string px = str.tostring(lvl, format.mintick)
    stage == 1 ? "IDM swept - " + px + " · WAIT for close back " + (side == 1 ? "above" : "below") + " → then " + d :
     stage == 2 ? "IDM swept + reclaimed - " + px + " → LOOK " + d + " · wait 0.50-0.62 / CHoCH" :
     stage == 3 ? "IDM → " + d + " CONFIRMED (" + (side == 1 ? "BOS↑" : "BOS↓") + ") - " + px :
     stage == 4 ? "IDM FAILED - protected " + (side == 1 ? "low" : "high") + " broken → NO " + d :
     stage == 5 ? "IDM swept - " + px + " · no reaction → stand aside" :
     "IDM - " + px + " · if swept → look " + d

f_idm_col(int stage, int side) =>
    color sc = side == 1 ? colBull : colBear
    stage == 1 ? colSweep : stage == 2 ? sc : stage == 3 ? sc : stage == 4 ? colExit : stage == 5 ? color.gray : colIdm

f_idm_short(int stage, int side, float lvl) =>
    string d  = side == 1 ? "LONG" : "SHORT"
    string px = str.tostring(lvl, format.mintick)
    stage == 1 ? "IDM swept " + px + " · wait close " + (side == 1 ? "above" : "below") :
     stage == 2 ? "IDM reclaimed " + px + " → " + d :
     stage == 3 ? "IDM ✓ " + d + " confirmed" :
     stage == 4 ? "IDM ✗ failed · no " + d :
     stage == 5 ? "IDM swept · no reaction" :
     "IDM " + px + " · sweep → " + d

// Compact status used when the IDM tag is folded under a Fib level tag.
f_idm_mini(int stage, int side) =>
    string d = side == 1 ? "LONG" : "SHORT"
    stage == 1 ? "IDM swept · wait" : stage == 2 ? "IDM reclaimed → " + d : stage == 3 ? "IDM ✓ " + d :
     stage == 4 ? "IDM ✗ failed" : stage == 5 ? "IDM · no reaction" : "IDM · sweep → " + d

// line ── tag ── line, tag centred on the IDM line (unswept space, so no candles under it); full text on hover
f_idm_layout(line l1, line l2, label lb, int t0, int t1, float y, int stage, int side, int step) =>
    color c = f_idm_col(stage, side)
    int gap = step * 5
    int mid = t0 + int((t1 - t0) / 2)
    bool split = t1 - t0 > gap * 3
    line.set_xy1(l1, t0, y)
    line.set_xy2(l1, split ? mid - gap : t1, y)
    line.set_xy1(l2, split ? mid + gap : t1, y)
    line.set_xy2(l2, t1, y)
    string sty = stage == 4 or stage == 5 ? line.style_dotted : line.style_dashed
    color lc = color.new(c, stage == 0 ? idmTrans : 20)
    line.set_style(l1, sty)
    line.set_style(l2, sty)
    line.set_color(l1, lc)
    line.set_color(l2, split ? lc : color(na))
    label.set_xy(lb, split ? mid : t1, y)
    label.set_style(lb, split ? label.style_none : label.style_label_left)
    label.set_color(lb, split ? color(na) : color.new(c, 15))
    label.set_textcolor(lb, split ? c : color.white)
    label.set_size(lb, size.small)
    label.set_text(lb, f_idm_short(stage, side, y))
    label.set_tooltip(lb, f_idm_txt(stage, side, y))

